# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
# Used by local `npm run start:dev`
MONGODB_URI=mongodb://localhost:27017/techng_lms
# Optional: override DB for Docker API container (defaults to mongodb://mongo:27017/techng_lms)
# DOCKER_MONGODB_URI=mongodb+srv://user:pass@cluster/techng_lms

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRATION=7d
ADMIN_JWT_SECRET=your_admin_jwt_secret_key
ADMIN_JWT_EXPIRATION=15m
ADMIN_JWT_REFRESH_SECRET=your_admin_refresh_secret

# Bcrypt
BCRYPT_ROUNDS=12
