# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
# Used by local `npm run start:dev`
MONGODB_URI=mongodb://localhost:27017/techng_lms
# Optional: override DB for Docker API container (defaults to mongodb://mongo:27017/techng_lms)
# DOCKER_MONGODB_URI=mongodb+srv://user:pass@cluster/techng_lms

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRATION=7d
ADMIN_JWT_SECRET=your_admin_jwt_secret_key
ADMIN_JWT_EXPIRATION=15m
ADMIN_JWT_REFRESH_SECRET=your_admin_refresh_secret

# Bcrypt
BCRYPT_ROUNDS=12

# Cloudflare R2 (S3-compatible) object storage
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=techng-lms
# Public URL: https://pub-<HASH>.r2.dev (the bucket's public custom domain or r2.dev URL)
R2_PUBLIC_BASE_URL=https://pub-<HASH>.r2.dev
R2_UPLOAD_EXPIRES_IN=900
R2_MAX_VIDEO_SIZE_MB=4096
R2_MAX_THUMBNAIL_SIZE_MB=10
